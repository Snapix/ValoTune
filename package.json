{
  "name": "valotune",
  "version": "2.0.0",
  "private": true,
  "description": "React music discovery app using Vite, Express, ytmusic-api, and YouTube embeds.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node server.js",
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --watch server.js",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ytmusic-api": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.5"
  }
}